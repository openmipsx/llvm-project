; A call to an ordinary function clobbers r2-r15: c is saved in r16.
declare i32 @f(i32, i32)
define i32 @ordinary(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: ordinary:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    st 0[r29],r16 ; 4-byte Folded Spill
; CHECK-NEXT:    .cfi_offset r16, -8
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    .cfi_escape 0x16, 0x1f, 0x05, 0x34, 0x1c, 0x06, 0x32, 0x24 ; r31 = [CFA-4] * 4
; CHECK-NEXT:    jspci r0,#%call(f),r31
; CHECK-NEXT:    mov r6,r16
; CHECK-NEXT:    nop
; CHECK-NEXT:    add r2,r16,r2
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    ld 0[r29],r16
; CHECK-NEXT:    addi r29,#8,r29
  %r = call i32 @f(i32 %a, i32 %b)
  %s = add i32 %r, %c
  ret i32 %s
}
