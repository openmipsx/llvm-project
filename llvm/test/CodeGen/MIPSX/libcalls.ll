; RUN: llc -mtriple=mipsx < %s | FileCheck %s

; Variable shifts, multiply and divide call the MIPS-X SDK helpers. A call
; to a helper preserves every register its clobber list (mipsx-sdk
; rt/builtins/README.md) leaves alone, so values stay in caller-saved
; registers across it.

define i32 @shl(i32 %a, i32 %b) {
; CHECK-LABEL: shl:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    .cfi_escape 0x16, 0x1f, 0x05, 0x34, 0x1c, 0x06, 0x32, 0x24 ; r31 = [CFA-4] * 4
; CHECK-NEXT:    jspci r0,#%call(__ashlsi3),r31
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r29,#8,r29
; CHECK-NEXT:    nop
  %r = shl i32 %a, %b
  ret i32 %r
}

define i32 @ashr(i32 %a, i32 %b) {
; CHECK-LABEL: ashr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    .cfi_escape 0x16, 0x1f, 0x05, 0x34, 0x1c, 0x06, 0x32, 0x24 ; r31 = [CFA-4] * 4
; CHECK-NEXT:    jspci r0,#%call(__ashrsi3),r31
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r29,#8,r29
; CHECK-NEXT:    nop
  %r = ashr i32 %a, %b
  ret i32 %r
}

; __lshrsi3 changes only r1-r3: the shift amount stays in r5.
define i32 @lshr_keep_r5(i32 %a, i32 %b) {
; CHECK-LABEL: lshr_keep_r5:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    .cfi_escape 0x16, 0x1f, 0x05, 0x34, 0x1c, 0x06, 0x32, 0x24 ; r31 = [CFA-4] * 4
; CHECK-NEXT:    jspci r0,#%call(__lshrsi3),r31
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    add r2,r5,r2
; CHECK-NEXT:    addi r29,#8,r29
  %r = lshr i32 %a, %b
  %s = add i32 %r, %b
  ret i32 %s
}

; __ashlsi3 also changes r5, so the amount is copied first; r6 survives.
define i32 @shl_keep(i32 %a, i32 %b) {
; CHECK-LABEL: shl_keep:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    .cfi_escape 0x16, 0x1f, 0x05, 0x34, 0x1c, 0x06, 0x32, 0x24 ; r31 = [CFA-4] * 4
; CHECK-NEXT:    jspci r0,#%call(__ashlsi3),r31
; CHECK-NEXT:    mov r5,r6
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    add r2,r6,r2
; CHECK-NEXT:    addi r29,#8,r29
  %r = shl i32 %a, %b
  %s = add i32 %r, %b
  ret i32 %s
}

