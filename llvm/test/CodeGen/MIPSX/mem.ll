; The loaded pointer is used after a nop, and a load never overwrites its
; address register (docs/abi.md section 9, P1 and P2).
define i32 @chase(ptr %p) {
; CHECK-LABEL: chase:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ld 0[r4],r3
; CHECK-NEXT:    ret
; CHECK-NEXT:    ld 0[r3],r2
; CHECK-NEXT:    nop
  %q = load ptr, ptr %p
  %v = load i32, ptr %q
  ret i32 %v
}
