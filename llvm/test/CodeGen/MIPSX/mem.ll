; Loads and stores of every width with sign and zero extension, and the
; reg+imm17 addressing mode.

define i32 @ld(ptr %p) {
; CHECK-LABEL: ld:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ret
; CHECK-NEXT:    ld 12[r4],r2
; CHECK-NEXT:    nop
  %q = getelementptr i32, ptr %p, i32 3
  %v = load i32, ptr %q
  ret i32 %v
}

define i32 @ldb(ptr %p) {
; CHECK-LABEL: ldb:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ret
; CHECK-NEXT:    ldb -1[r4],r2
; CHECK-NEXT:    nop
  %q = getelementptr i8, ptr %p, i32 -1
  %v = load i8, ptr %q
  %r = sext i8 %v to i32
  ret i32 %r
}

define i32 @ldbu(ptr %p) {
; CHECK-LABEL: ldbu:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ret
; CHECK-NEXT:    ldbu 0[r4],r2
; CHECK-NEXT:    nop
  %v = load i8, ptr %p
  %r = zext i8 %v to i32
  ret i32 %r
}

