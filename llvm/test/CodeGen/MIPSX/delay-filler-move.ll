; Delay slot filling that makes code smaller (S16): instructions move into
; the slots instead of being copied when the branch is the only way into
; the block they come from.

; The taken target (%f here) is reached only by the branch: its first two
; instructions move into the squashed slots, and the target keeps its
; label.
define i32 @move_from_target(i32 %a, i32 %b, ptr %p) {
; CHECK-LABEL: move_from_target:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    bnesq r4,r5,.LBB0_2
; CHECK-NEXT:    mov r5,r2
; CHECK-NEXT:    st 0[r6],r5
; CHECK-NEXT:  ; %bb.1: ; %t
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r4,#7,r2
; CHECK-NEXT:    st 4[r6],r2
; CHECK-NEXT:  .LBB0_2: ; %f
; CHECK-NEXT:    ret
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
;
; NOFT-LABEL: move_from_target:
; NOFT:       ; %bb.0:
; NOFT-NEXT:    bnesq r4,r5,.LBB0_2
; NOFT-NEXT:    mov r5,r2
; NOFT-NEXT:    st 0[r6],r5
; NOFT-NEXT:  ; %bb.1: ; %t
; NOFT-NEXT:    ret
; NOFT-NEXT:    addi r4,#7,r2
; NOFT-NEXT:    st 4[r6],r2
; NOFT-NEXT:  .LBB0_2: ; %f
; NOFT-NEXT:    ret
; NOFT-NEXT:    nop
; NOFT-NEXT:    nop
  %c = icmp eq i32 %a, %b
  br i1 %c, label %t, label %f, !prof !0
t:
  %x = add i32 %a, 7
  %q = getelementptr i32, ptr %p, i32 1
  store i32 %x, ptr %q
  ret i32 %x
f:
  store i32 %b, ptr %p
  ret i32 %b
}

