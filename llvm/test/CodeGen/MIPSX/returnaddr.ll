; __builtin_return_address and __builtin_frame_address. r31 holds a word
; address, so the result is r31 << 2. Outer frames follow the fp chain:
; the caller's fp is at fp - 8 and its return address at fp - 4. r31 is
; also a function live-in here, so the prologue's spill must not kill it.

declare ptr @llvm.returnaddress(i32)
declare ptr @llvm.frameaddress.p0(i32)
declare void @g(ptr)

define ptr @ra0() {
; CHECK-LABEL: ra0:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    st 0[r29],r16 ; 4-byte Folded Spill
; CHECK-NEXT:    lsl r31,r16,#2
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    jspci r0,#%call(g),r31
; CHECK-NEXT:    mov r16,r4
; CHECK-NEXT:    nop
; CHECK-NEXT:    mov r16,r2
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    ld 0[r29],r16
; CHECK-NEXT:    addi r29,#8,r29
  %r = call ptr @llvm.returnaddress(i32 0)
  call void @g(ptr %r)
  ret ptr %r
}

define ptr @ra1() "frame-pointer"="all" {
; CHECK-LABEL: ra1:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
