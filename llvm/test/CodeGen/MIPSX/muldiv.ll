define i32 @udivrem(i32 %a, i32 %b, ptr %p) {
; CHECK-LABEL: udivrem:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    jspci r0,#%call(__udivsi3),r31
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    st 0[r6],r3
; CHECK-NEXT:    addi r29,#8,r29
  %q = udiv i32 %a, %b
  %r = urem i32 %a, %b
  store i32 %r, ptr %p
  ret i32 %q
}

; A signed quotient and remainder stay two calls: __divsi3 does not promise
; the remainder.
define i32 @sdivrem(i32 %a, i32 %b, ptr %p) {
; CHECK-LABEL: sdivrem:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    jspci r0,#%call(__divsi3),r31
; CHECK-NEXT:    mov r5,r7
; CHECK-NEXT:    mov r4,r8
; CHECK-NEXT:    mov r8,r4
; CHECK-NEXT:    jspci r0,#%call(__modsi3),r31
; CHECK-NEXT:    mov r7,r5
; CHECK-NEXT:    mov r2,r9
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    st 0[r6],r2
; CHECK-NEXT:    ret
; CHECK-NEXT:    mov r9,r2
; CHECK-NEXT:    addi r29,#8,r29
  %q = sdiv i32 %a, %b
  %r = srem i32 %a, %b
  store i32 %r, ptr %p
  ret i32 %q
}
