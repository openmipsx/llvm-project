; Multiplication by a constant becomes shifts and adds (the non-adjacent
; form of the constant) when that takes at most -mipsx-mul-const-max-insts
; instructions, otherwise a call to __mulsi3. Division by a power of two is
; shifts; other divisors call the SDK helpers. A quotient and remainder of
; the same operands are one call to __udivsi3, which leaves the remainder in
; r3 (mipsx-sdk rt/builtins/README.md).

; 3x = 4x - x
define i32 @mul3(i32 %x) {
; CHECK-LABEL: mul3:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ret
; CHECK-NEXT:    lsl r4,r2,#2
; CHECK-NEXT:    sub r2,r4,r2
  %r = mul i32 %x, 3
  ret i32 %r
}

; 10x = 8x + 2x
define i32 @mul10(i32 %x) {
; CHECK-LABEL: mul10:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    lsl r4,r2,#3
; CHECK-NEXT:    ret
; CHECK-NEXT:    lsl r4,r3,#1
; CHECK-NEXT:    add r3,r2,r2
  %r = mul i32 %x, 10
  ret i32 %r
}

; 100x = 4x - 32x + 128x
define i32 @mul100(i32 %x) {
; CHECK-LABEL: mul100:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    lsl r4,r2,#5
; CHECK-NEXT:    lsl r4,r3,#2
; CHECK-NEXT:    sub r3,r2,r2
; CHECK-NEXT:    ret
; CHECK-NEXT:    lsl r4,r3,#7
; CHECK-NEXT:    add r2,r3,r2
  %r = mul i32 %x, 100
  ret i32 %r
}

; -7x = x - 8x
define i32 @mul_neg7(i32 %x) {
; CHECK-LABEL: mul_neg7:
