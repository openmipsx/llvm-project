; Function pointers are byte addresses (docs/abi.md section 4): an indirect
; call shifts right by 2 and jumps with jspci rs,#0,r31 (abi section 5.6).
; With long-calls, direct calls take the address with %hi/%lo the same way
; (abi section 5.4).

define i32 @icall(ptr %f, i32 %x) {
; CHECK-LABEL: icall:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    lsr r4,r2,#2
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    jspci r2,#0,r31
; CHECK-NEXT:    mov r5,r4
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r29,#8,r29
; CHECK-NEXT:    nop
;
; LONG-LABEL: icall:
; LONG:       ; %bb.0:
; LONG-NEXT:    addi r29,#-8,r29
; LONG-NEXT:    lsr r4,r2,#2
; LONG-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; LONG-NEXT:    jspci r2,#0,r31
; LONG-NEXT:    mov r5,r4
; LONG-NEXT:    nop
; LONG-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; LONG-NEXT:    nop
; LONG-NEXT:    ret
; LONG-NEXT:    addi r29,#8,r29
; LONG-NEXT:    nop
  %r = call i32 %f(i32 %x)
  ret i32 %r
}

