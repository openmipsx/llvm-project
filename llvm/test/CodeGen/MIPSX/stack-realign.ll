; Objects aligned beyond the 8-byte stack alignment realign the stack: the
; prologue sets fp = CFA, then rounds sp down; the body addresses locals from
; sp and the epilogue resets sp from fp.

declare void @g(ptr)

define i32 @f(i32 %a) {
; CHECK-LABEL: f:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-64,r29
; CHECK-NEXT:    .cfi_def_cfa_offset 64
; CHECK-NEXT:    addi r0,#-32,r1
; CHECK-NEXT:    st 56[r29],r30 ; 4-byte Folded Spill
; CHECK-NEXT:    .cfi_offset r30, -8
; CHECK-NEXT:    st 60[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    .cfi_escape 0x16, 0x1f, 0x05, 0x34, 0x1c, 0x06, 0x32, 0x24 ; r31 = [CFA-4] * 4
; CHECK-NEXT:    addi r29,#64,r30
; CHECK-NEXT:    .cfi_def_cfa r30, 0
; CHECK-NEXT:    and r29,r1,r29
; CHECK-NEXT:    jspci r0,#%call(g),r31
; CHECK-NEXT:    st 28[r29],r4
; CHECK-NEXT:    addi r29,#32,r4
; CHECK-NEXT:    jspci r0,#%call(g),r31
; CHECK-NEXT:    addi r29,#28,r4
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld 32[r29],r2
; CHECK-NEXT:    addi r30,#-64,r29
; CHECK-NEXT:    ld 60[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    ld 56[r29],r30
; CHECK-NEXT:    addi r29,#64,r29
  %x = alloca [4 x i32], align 32
  %y = alloca i32, align 4
  store i32 %a, ptr %y
  call void @g(ptr %x)
  call void @g(ptr %y)
  %v = load i32, ptr %x
  ret i32 %v
}

