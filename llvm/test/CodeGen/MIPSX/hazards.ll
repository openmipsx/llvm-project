; Delay slots and load delays (docs/abi.md section 9). MIPSXDelaySlotFiller
; moves independent instructions into the two slots of each branch, call and
; return, or copies the start of a loop's target into the slots of a
; squashing branch; MIPSXHazardPadding adds nops for what is left, and after
; a load only when the next instruction reads the loaded register. With
; the filler disabled every slot holds a nop.

declare void @f(i32, i32)

; A load directly followed by its use needs a nop.
define i32 @load_use(ptr %p) {
; CHECK-LABEL: load_use:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ld 0[r4],r2
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r2,#1,r2
; CHECK-NEXT:    nop
;
; NOFILL-LABEL: load_use:
; NOFILL:       ; %bb.0:
; NOFILL-NEXT:    ld 0[r4],r2
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    addi r2,#1,r2
; NOFILL-NEXT:    ret
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    nop
  %v = load i32, ptr %p
  %w = add i32 %v, 1
  ret i32 %w
}

; The scheduler puts the second load between the first and its use.
define i32 @two_loads(ptr %p, ptr %q) {
; CHECK-LABEL: two_loads:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ld 0[r4],r2
; CHECK-NEXT:    ld 0[r5],r3
; CHECK-NEXT:    ret
; CHECK-NEXT:    add r2,r3,r2
; CHECK-NEXT:    nop
;
; NOFILL-LABEL: two_loads:
; NOFILL:       ; %bb.0:
; NOFILL-NEXT:    ld 0[r4],r2
; NOFILL-NEXT:    ld 0[r5],r3
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    add r2,r3,r2
; NOFILL-NEXT:    ret
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    nop
  %a = load i32, ptr %p
  %b = load i32, ptr %q
  %s = add i32 %a, %b
  ret i32 %s
}

