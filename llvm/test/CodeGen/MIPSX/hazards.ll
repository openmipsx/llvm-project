; A loop branch copies the first instructions of the loop into its slots and
; squashes them when it falls out of the loop.
define i32 @loop(ptr %p, i32 %n) {
; CHECK-LABEL: loop:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    mov r0,r3
; CHECK-NEXT:    mov r0,r2
; CHECK-NEXT:  .LBB4_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ld 0[r4],r6
; CHECK-NEXT:    addi r3,#1,r3
; CHECK-NEXT:    blt r3,r5,.LBB4_1
; CHECK-NEXT:    addi r4,#4,r4
; CHECK-NEXT:    add r2,r6,r2
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    ret
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
;
; NOFILL-LABEL: loop:
; NOFILL:       ; %bb.0: ; %entry
; NOFILL-NEXT:    mov r0,r3
; NOFILL-NEXT:    mov r0,r2
; NOFILL-NEXT:  .LBB4_1: ; %loop
; NOFILL-NEXT:    ; =>This Inner Loop Header: Depth=1
; NOFILL-NEXT:    ld 0[r4],r6
; NOFILL-NEXT:    addi r3,#1,r3
; NOFILL-NEXT:    addi r4,#4,r4
; NOFILL-NEXT:    add r2,r6,r2
; NOFILL-NEXT:    blt r3,r5,.LBB4_1
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    nop
; NOFILL-NEXT:  ; %bb.2: ; %exit
; NOFILL-NEXT:    ret
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    nop
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %s = phi i32 [ 0, %entry ], [ %s1, %loop ]
  %q = getelementptr i32, ptr %p, i32 %i
  %v = load i32, ptr %q
  %s1 = add i32 %s, %v
  %i1 = add i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %s1
}

; A load never writes its own address register (P2).
define i32 @chase(ptr %p) {
; CHECK-LABEL: chase:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ld 0[r4],r3
; CHECK-NEXT:    ret
; CHECK-NEXT:    ld 0[r3],r2
; CHECK-NEXT:    nop
;
; NOFILL-LABEL: chase:
; NOFILL:       ; %bb.0:
; NOFILL-NEXT:    ld 0[r4],r3
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    ld 0[r3],r2
; NOFILL-NEXT:    ret
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    nop
  %q = load ptr, ptr %p
  %v = load i32, ptr %q
  ret i32 %v
}

; Here only one instruction can move from above, but the loop's first two
; instructions can be copied: the branch squashes, and targets the third.
define void @squash(ptr %f, i32 %start, i32 %step, i32 %n) {
; CHECK-LABEL: squash:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    addi r0,#1,r2
; CHECK-NEXT:  ; %bb.1: ; %mark
; CHECK-NEXT:    add r4,r5,r3
; CHECK-NEXT:    add r5,r6,r5
; CHECK-NEXT:  .LBB6_3: ; %mark
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    stb 0[r3],r2
; CHECK-NEXT:    blosq r5,r7,.LBB6_3
; CHECK-NEXT:    add r4,r5,r3
; CHECK-NEXT:    add r5,r6,r5
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    ret
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
;
; NOFILL-LABEL: squash:
; NOFILL:       ; %bb.0: ; %entry
; NOFILL-NEXT:    addi r0,#1,r2
; NOFILL-NEXT:  .LBB6_1: ; %mark
; NOFILL-NEXT:    ; =>This Inner Loop Header: Depth=1
; NOFILL-NEXT:    add r4,r5,r3
; NOFILL-NEXT:    add r5,r6,r5
; NOFILL-NEXT:    stb 0[r3],r2
; NOFILL-NEXT:    blo r5,r7,.LBB6_1
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    nop
; NOFILL-NEXT:  ; %bb.2: ; %exit
; NOFILL-NEXT:    ret
; NOFILL-NEXT:    nop
; NOFILL-NEXT:    nop
entry:
  br label %mark
mark:
  %j = phi i32 [ %start, %entry ], [ %j1, %mark ]
  %pj = getelementptr i8, ptr %f, i32 %j
  store i8 1, ptr %pj
  %j1 = add i32 %j, %step
  %more = icmp ult i32 %j1, %n
  br i1 %more, label %mark, label %exit
exit:
  ret void
}
