; RUN: llc -mtriple=mipsx -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=mipsx -O0 -verify-machineinstrs < %s -o /dev/null

; The delay-slot filler keeps register liveness valid for the machine
; verifier: a call's argument or a return's result set in a delay slot is
; an internal read of the bundle, as is the second slot reading the first,
; and kill flags move to the last reader.

declare void @h(i32, i32)

; Both arguments are set in the call's slots, the result in the return's.
define i32 @call_args() {
; CHECK-LABEL: call_args:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    jspci r0,#%call(h),r31
; CHECK-NEXT:    addi r0,#1,r4
; CHECK-NEXT:    addi r0,#2,r5
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r0,#3,r2
; CHECK-NEXT:    addi r29,#8,r29
  call void @h(i32 1, i32 2)
  ret i32 3
}

; The second slot reads what the first one sets.
define i32 @chain(ptr %p, i32 %a) {
; CHECK-LABEL: chain:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    lsl r5,r2,#2
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r2,#4,r2
; CHECK-NEXT:    st 0[r4],r2
  %x = add i32 %a, 1
  %y = shl i32 %x, 2
  store i32 %y, ptr %p
  ret i32 %y
}

; A slot reads the branch's operand after the branch.
define i32 @branch_kill(i32 %a, i32 %b) {
; CHECK-LABEL: branch_kill:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    bnesq r4,r5,.LBB2_3
; CHECK-NEXT:    mov r0,r2
; CHECK-NEXT:    nop
; CHECK-NEXT:  ; %bb.1: ; %t
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r4,#7,r2
; CHECK-NEXT:    nop
; CHECK-NEXT:  ; %bb.2: ; %f
; CHECK-NEXT:    mov r0,r2
; CHECK-NEXT:  .LBB2_3: ; %f
; CHECK-NEXT:    ret
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
entry:
  %c = icmp eq i32 %a, %b
  %s = add i32 %a, 7
  br i1 %c, label %t, label %f
t:
  ret i32 %s
f:
  ret i32 0
}
