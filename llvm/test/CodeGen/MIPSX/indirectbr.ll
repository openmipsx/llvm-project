; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mipsx < %s | FileCheck %s

; Block addresses are byte addresses like any pointer (docs/abi.md section
; 4), so an indirect branch shifts right by 2 before jspci.

define i32 @computed(i32 %x) {
; CHECK-LABEL: computed:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    beqsq r4,r0,.LBB0_5
; CHECK-NEXT:    addi r0,#%hi(.Ltmp0),r2
; CHECK-NEXT:    lsl r2,r2,#15
; CHECK-NEXT:  ; %bb.1: ; %entry
; CHECK-NEXT:    addi r0,#%hi(.Ltmp1),r2
; CHECK-NEXT:    lsl r2,r2,#15
; CHECK-NEXT:    addi r2,#%lo(.Ltmp1),r2
; CHECK-NEXT:    lsr r2,r2,#2
; CHECK-NEXT:    jspci r2,#0,r0
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:  .Ltmp1: ; Block address taken
; CHECK-NEXT:  .LBB0_2: ; %b
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r0,#2,r2
; CHECK-NEXT:    nop
; CHECK-NEXT:  ; %bb.3:
; CHECK-NEXT:    addi r0,#%hi(.Ltmp0),r2
; CHECK-NEXT:    lsl r2,r2,#15
; CHECK-NEXT:  .LBB0_5:
; CHECK-NEXT:    addi r2,#%lo(.Ltmp0),r2
; CHECK-NEXT:    lsr r2,r2,#2
; CHECK-NEXT:    jspci r2,#0,r0
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:  .Ltmp0: ; Block address taken
; CHECK-NEXT:  .LBB0_4: ; %a
; CHECK-NEXT:    ret
; CHECK-NEXT:    addi r0,#1,r2
; CHECK-NEXT:    nop
entry:
  %u = icmp eq i32 %x, 0
  %d = select i1 %u, ptr blockaddress(@computed, %a), ptr blockaddress(@computed, %b)
  indirectbr ptr %d, [label %a, label %b]
a:
  ret i32 1
b:
  ret i32 2
}
