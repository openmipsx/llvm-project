; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ret
; CHECK-NEXT:    ld 8[r29],r2
; CHECK-NEXT:    addi r29,#16,r29
  %slot = alloca [4 x i32], align 4
