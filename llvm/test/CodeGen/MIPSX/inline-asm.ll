; RUN: llc -mtriple=mipsx < %s | FileCheck %s

; Inline assembly: "r" registers print as rN, "I" (simm17), "J" (zero) and
; "K" (0-31) immediates as numbers (the template writes '#'), and "m" as
; off[rN].

define i32 @reg(i32 %a, i32 %b) {
; CHECK-LABEL: reg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    add r4,r5,r2
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ret
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
  %r = call i32 asm "add $1,$2,$0", "=r,r,r"(i32 %a, i32 %b)
  ret i32 %r
}

define i32 @imm(i32 %a) {
; CHECK-LABEL: imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    addi r4,#-65536,r2
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    addi r2,#65535,r2
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    mov r2,r2
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    asr r2,r2,#31
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ret
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
  %r = call i32 asm "addi $1,#$2,$0", "=r,r,I"(i32 %a, i32 -65536)
  %s = call i32 asm "addi $1,#$2,$0", "=r,r,I"(i32 %r, i32 65535)
  %t = call i32 asm "add $1,r$2,$0", "=r,r,J"(i32 %s, i32 0)
  %u = call i32 asm "asr $1,$0,#$2", "=r,r,K"(i32 %t, i32 31)
  ret i32 %u
}

