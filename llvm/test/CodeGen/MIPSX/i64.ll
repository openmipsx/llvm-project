; __udivdi3 changes r1-r11: c moves to r12 rather than a callee-saved
; register.
define i64 @keep(i64 %a, i64 %b, i32 %c) {
; CHECK-LABEL: keep:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    addi r29,#-8,r29
; CHECK-NEXT:    st 4[r29],r31 ; 4-byte Folded Spill
; CHECK-NEXT:    jspci r0,#%call(__udivdi3),r31
; CHECK-NEXT:    mov r8,r12
; CHECK-NEXT:    nop
; CHECK-NEXT:    mov r3,r4
; CHECK-NEXT:    add r4,r12,r3
; CHECK-NEXT:    blosq r3,r4,.LBB6_2
; CHECK-NEXT:    addi r0,#1,r4
; CHECK-NEXT:    nop
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    b .LBB6_3
; CHECK-NEXT:    mov r0,r4
; CHECK-NEXT:    nop
; CHECK-NEXT:  .LBB6_2:
; CHECK-NEXT:  .LBB6_3:
; CHECK-NEXT:    ld 4[r29],r31 ; 4-byte Folded Reload
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
; CHECK-NEXT:    add r2,r4,r2
; CHECK-NEXT:    addi r29,#8,r29
  %r = udiv i64 %a, %b
  %e = zext i32 %c to i64
  %s = add i64 %r, %e
  ret i64 %s
}
